<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- title comes from the route: res.render('view', { title: '...' }) -->
    <title><%= title %> | Mahdey Hussain</title>

    <!-- Bootstrap and Font Awesome, served from node_modules (see app.js) -->
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css">
    <!-- my own CSS goes last so it can override Bootstrap -->
    <link rel="stylesheet" href="/Content/app.css">
</head>

<body>
    <!-- shared navbar: Bootstrap navbar that collapses into a menu button on small screens -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/home"><i class="fa-solid fa-code"></i> Mahdey Hussain</a>

            <!-- hamburger button, only shows on small screens -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link <%= title == 'Home' ? 'active' : '' %>" href="/home">
                            <i class="fa-solid fa-house"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= title == 'About Me' ? 'active' : '' %>" href="/about">
                            <i class="fa-solid fa-user"></i> About Me</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= title == 'Projects' ? 'active' : '' %>" href="/projects">
                            <i class="fa-solid fa-folder-open"></i> Projects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= title == 'Contact Me' ? 'active' : '' %>" href="/contact">
                            <i class="fa-solid fa-envelope"></i> Contact Me</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- main content of each page goes between the header and footer partials -->
    <main class="container my-4">