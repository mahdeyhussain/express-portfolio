<%- include('partials/header') %>

<!-- welcome section: Bootstrap grid, 2 columns on medium screens and up, stacked on phones -->
<section class="row g-4 my-4">
    <div class="col-md-8">
        <h1 class="display-5 fw-bold">Welcome to my portfolio!</h1>
        <p class="lead">I'm Mahdey, a Technology Management student at Ontario Tech University with a passion
            for tech, working with people, and problem solving.</p>
        <a href="/about" class="btn btn-primary btn-lg me-2 mb-2"><i class="fa-solid fa-user"></i> About Me</a>
        <a href="/contact" class="btn btn-outline-primary btn-lg mb-2"><i class="fa-solid fa-envelope"></i> Contact Me</a>
    </div>
    <div class="col-md-4 text-center">
        <img src="/Asset/images/mahdey.jpg" alt="Photo of Mahdey Hussain" class="img-fluid rounded-circle shadow">
    </div>
</section>

<!-- what you'll find here: three Bootstrap cards that link to the other pages -->
<h2 class="mt-5 mb-3">What You'll Find Here</h2>
<section class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h3 class="h5 card-title"><i class="fa-solid fa-user"></i> About Me</h3>
                <p class="card-text">Who I am, what I study, and what I'm interested in.</p>
                <a href="/about" class="btn btn-sm btn-primary">Learn more</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h3 class="h5 card-title"><i class="fa-solid fa-folder-open"></i> Projects</h3>
                <p class="card-text">School and personal projects I've worked on.</p>
                <a href="/projects" class="btn btn-sm btn-primary">View projects</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h3 class="h5 card-title"><i class="fa-solid fa-envelope"></i> Contact Me</h3>
                <p class="card-text">Have a question or want to work together? Send me a message.</p>
                <a href="/contact" class="btn btn-sm btn-primary">Get in touch</a>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>